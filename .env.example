# Copy to .env for local (host) apps talking to Docker infra.
# Inside Compose "full" profile, service hostnames replace localhost.

NODE_ENV=development
API_PORT=3000

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=pulsegate
POSTGRES_PASSWORD=pulsegate
POSTGRES_DB=pulsegate

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Credit leasing
LEASE_DEFAULT_SIZE=1000
LEASE_REFILL_THRESHOLD=0.3

# Kafka
KAFKA_BROKERS=localhost:9092

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=pulsegate
CLICKHOUSE_DB=pulsegate

# Operator simulator (when running locally)
OPERATOR_SIM_URL=http://localhost:3010

# Admit rate limit (hard ceiling → HTTP 429)
RATE_LIMIT_EXPRESS=200
RATE_LIMIT_NORMAL=50
RATE_LIMIT_WINDOW_SEC=1

# Worker circuit breaker (operator)
CB_FAILURE_THRESHOLD=5
CB_OPEN_MS=10000

# Operator simulator (process env on operator-sim)
# OPERATOR_FAIL_RATE=0.02
# OPERATOR_PORT=3010
